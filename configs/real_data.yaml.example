project:
  run_name: real_data_experiment
  seed: 42

data:
  root: data/real
  classes: [Fe, Cu, Na, Ca, Mg]
  image_size: 224
  num_workers: 0

model:
  name: resnet18
  pretrained: true
  dropout: 0.2

training:
  epochs: 30
  batch_size: 16
  learning_rate: 0.0003
  weight_decay: 0.0001
  early_stopping_patience: 7
  device: auto

augmentation:
  rotation_degrees: 1.0
  vertical_shift: 0.02
  brightness: 0.05
  contrast: 0.05

output:
  root: outputs/real_data_experiment
